{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "desktop",
      "displayName": "Desktop",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.8.3/gcc_64"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86_64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-x86_64",
      "environment": {
        "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk",
        "PATH": "/usr/lib/jvm/java-17-openjdk/bin:$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{HOME}/Qt/6.8.3/android_x86_64/lib/cmake/Qt6/qt.toolchain.cmake",
        "ANDROID_SDK_ROOT": "$env{ANDROID_HOME}",
        "ANDROID_NDK_ROOT": "$env{ANDROID_NDK_ROOT}",
        "ANDROID_ABI": "x86_64",
        "ANDROID_PLATFORM": "android-28",
        "QT_HOST_PATH": "$env{HOME}/Qt/6.8.3/gcc_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop"
    },
    {
      "name": "android-x86_64",
      "configurePreset": "android-x86_64",
      "environment": {
        "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk",
        "PATH": "/usr/lib/jvm/java-17-openjdk/bin:$penv{PATH}"
      }
    }
  ]
}
